{
  "name": "quack-abb",
  "displayName": "QUACK",
  "description": "AI-assisted code review from the quack server.",
  "version": "0.1.0",
  "publisher": "quack",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Linters"
  ],
  "main": "./out/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      {
        "command": "quack.check",
        "title": "QUACK: Check staged changes"
      }
    ],
    "configuration": {
      "title": "QUACK",
      "properties": {
        "quack.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "description": "Base URL of the running quack serve instance."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/vscode": "^1.136.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^7.0.2"
  }
}