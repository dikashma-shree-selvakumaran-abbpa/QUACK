{
  "servers": {
    "sonarqube": {
      "command": "podman",
      "args": [
        "run",
        "--init",
        "-i",
        "--rm",
        "-e",
        "SONARQUBE_TOKEN",
        "-e",
        "SONARQUBE_URL",
        "-e",
        "SONARQUBE_MCP_IN_CONTAINER",
        "-e",
        "SONARQUBE_READ_ONLY",
        "mcp/sonarqube"
      ],
      "env": {
        "SONARQUBE_URL": "https://codescan.abb.com",
        "SONARQUBE_TOKEN": "${SQ_TOKEN}",
        "SONARQUBE_MCP_IN_CONTAINER": "true",
        "SONARQUBE_READ_ONLY": "true"
      }
    }
  }
}
